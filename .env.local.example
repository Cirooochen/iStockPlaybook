# Copy this file to .env.local (which is gitignored — see .gitignore's
# `.env*` rule) and fill in real values. Never commit .env.local.

# Used by scripts/validate-live-market-data.ts (Phase C.8B) via
# src/infrastructure/market-data/twelve-data/env.ts. Not read anywhere
# else in this codebase.
TWELVE_DATA_API_KEY=

# Used by scripts/validate-live-sec-edgar-fundamentals.ts (Phase E.7B)
# via src/infrastructure/market-data/sec-edgar/env.ts — "<app name>
# <contact email>", identifying this application per SEC's fair-access
# policy for data.sec.gov/www.sec.gov (https://www.sec.gov/os/webmaster-
# faq#developers). No API key exists for this provider.
SEC_EDGAR_USER_AGENT=

# Used by src/app/api/ai/evidence-brief/route.ts and
# src/app/api/ai/intent-assist/route.ts (Phase H.5, via
# src/infrastructure/ai/anthropic/env.ts) — server-only, never read
# anywhere else. Entirely optional: the onboarding flow works fully
# without it, and both AI surfaces simply show "unavailable" when unset
# (docs/phase-h5-ai-assisted-research-design.md §7) — nothing in the
# deterministic Proposal/materialize-config/Engine pipeline depends on it.
ANTHROPIC_API_KEY=
